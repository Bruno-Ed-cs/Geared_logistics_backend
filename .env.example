# ------------------------------------------------------------------
# Geared Logistics - variaveis de ambiente do backend
# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env
# ------------------------------------------------------------------

# Conexao com o PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/geared_logistics
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Segredo para assinatura dos tokens JWT (minimo 32 caracteres)
JWT_SECRET=troque-este-segredo-em-producao-com-pelo-menos-32-caracteres
